# PoultryVision Environment Variables

# 1. Google Sheets Waitlist Integration (Google Apps Script Web App URL)
VITE_GOOGLE_SHEET_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# 2. Meta WhatsApp Cloud API (Automated Alert Dispatch & Diagnostic Testing)
# Obtain these from your Meta Developer Dashboard (developers.facebook.com) -> WhatsApp -> API Setup:
VITE_META_WA_PHONE_NUMBER_ID=your_phone_number_id_here
VITE_META_WA_ACCESS_TOKEN=your_permanent_or_system_user_token_here
# Optional template name (if sending to numbers outside the 24-hr customer service window):
VITE_META_WA_TEMPLATE_NAME=
VITE_META_WA_VERSION=v21.0
